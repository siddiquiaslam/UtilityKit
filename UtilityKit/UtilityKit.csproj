<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Mandatory Identification -->
    <PackageId>UtilityKit</PackageId>
    <Version>1.0.1</Version>
    <Authors>siddiquiaslam</Authors>
    <Description>UtilityKit is a lightweight, extensible collection of helper classes and functions designed to simplify everyday development tasks. From date and time utilities to string manipulation and common data operations, UtilityKit provides a clean, reusable toolkit that saves you from rewriting boilerplate code again and again.</Description>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Source Code & Licensing (Crucial for Public Repos) -->
    <RepositoryUrl>[https://github.com/siddiquiaslam/UtilityKit](https://github.com/siddiquiaslam/UtilityKit)</RepositoryUrl>
    <PackageProjectUrl>[https://github.com/siddiquiaslam/UtilityKit](https://github.com/siddiquiaslam/UtilityKit)</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Source Link / Debugging Support (Best Practice) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedAllSources>true</EmbedAllSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.xml</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <!-- Optional: Ensure documentation is built and included in the package -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\LICENSE.md" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
